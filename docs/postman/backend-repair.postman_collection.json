{
  "info": {
    "name": "backend-repair API",
    "description": "Infrastructure-level collection for backend-repair health and API root checks.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        },
        {
          "name": "API Root",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiVersion}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiVersion}}",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiVersion}}",
                "auth",
                "refresh"
              ]
            }
          }
        },
        {
          "name": "Current Staff",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiVersion}}",
                "auth",
                "me"
              ]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiVersion}}",
                "auth",
                "logout"
              ]
            }
          }
        },
        {
          "name": "Protected Example",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiVersion}}",
                "auth",
                "me"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Repair Tickets",
      "item": [
        {
          "name": "Create Ticket",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer\": {\n    \"fullName\": \"Walk-in Customer\",\n    \"phone\": \"+18885550100\",\n    \"email\": \"walkin@example.local\",\n    \"address\": \"Sample address\"\n  },\n  \"title\": \"iPhone screen repair\",\n  \"description\": \"Customer reports broken display after drop.\",\n  \"priority\": \"NORMAL\",\n  \"items\": [\n    {\n      \"itemType\": \"mobile_phone\",\n      \"brand\": \"Apple\",\n      \"model\": \"iPhone 13\",\n      \"imei\": \"356789012345678\",\n      \"condition\": \"Screen cracked, device powers on\",\n      \"accessories\": [\"case\", \"sim tray\"],\n      \"lockPin\": \"123456\"\n    }\n  ],\n  \"issues\": [\n    {\n      \"title\": \"Screen broken\",\n      \"description\": \"Display glass cracked and touch intermittent\"\n    },\n    {\n      \"title\": \"Battery check requested\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/repair/tickets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiVersion}}",
                "repair",
                "tickets"
              ]
            }
          }
        },
        {
          "name": "List Tickets",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/repair/tickets?page=1&limit=20&search=screen",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiVersion}}",
                "repair",
                "tickets"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "search",
                  "value": "screen"
                }
              ]
            }
          }
        },
        {
          "name": "Get Ticket",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/repair/tickets/{{ticketId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiVersion}}",
                "repair",
                "tickets",
                "{{ticketId}}"
              ]
            }
          }
        },
        {
          "name": "Update Ticket Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"DIAGNOSING\",\n  \"reason\": \"Technician started diagnosis\",\n  \"metadata\": {\n    \"source\": \"postman\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/repair/tickets/{{ticketId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiVersion}}",
                "repair",
                "tickets",
                "{{ticketId}}",
                "status"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Customers",
      "item": [
        {
          "name": "Search Customers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/customers/search?query=walk&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiVersion}}",
                "customers",
                "search"
              ],
              "query": [
                {
                  "key": "query",
                  "value": "walk"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Customer Ticket History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/customers/{{customerId}}/tickets?page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiVersion}}",
                "customers",
                "{{customerId}}",
                "tickets"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
