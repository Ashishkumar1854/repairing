generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BusinessType {
  REPAIR_SHOP
  SERVICE_CENTER
  REFURBISHER
  ENTERPRISE
}

enum TicketStatus {
  RECEIVED
  DIAGNOSING
  ESTIMATE_PENDING
  WAITING_APPROVAL
  APPROVED
  IN_REPAIR
  WAITING_PARTS
  SENT_TO_VENDOR
  READY_FOR_REVIEW
  READY_FOR_DELIVERY
  DELIVERED
  CANCELLED
  CLOSED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
  REFUNDED
}

enum InvoiceItemSourceType {
  ESTIMATE
  ACTUAL_USAGE
  MANUAL
  LABOR
}

enum RepairPaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK_TRANSFER
  WALLET
}

enum LedgerEntryType {
  INVOICE_ISSUED
  PAYMENT_RECEIVED
  ADJUSTMENT
  REFUND
}

enum FinancialAuditAction {
  INVOICE_CREATED
  INVOICE_ISSUED
  PAYMENT_COLLECTED
  INVOICE_PARTIALLY_PAID
  INVOICE_PAID
  INVOICE_CANCELLED
  REFUND_RECORDED
}

enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  PAUSED
  COMPLETED
  REASSIGNED
  CANCELLED
}

enum AssignmentEventType {
  ASSIGNED
  REASSIGNED
  UNASSIGNED
}

enum TechnicianActivityType {
  ASSIGNMENT_CREATED
  ASSIGNMENT_REASSIGNED
  ASSIGNMENT_ACCEPTED
  DIAGNOSIS_STARTED
  REPAIR_STARTED
  PARTS_CONSUMED
  REPAIR_PAUSED
  REPAIR_RESUMED
  REPAIR_COMPLETED
}

enum StaffRole {
  SUPER_ADMIN
  OWNER
  ADMIN
  TECHNICIAN
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
}

enum SubscriptionPlan {
  STARTER
  GROWTH
  ENTERPRISE
}

enum SubscriptionStatus {
  PENDING
  DONE
  ACTIVE
  TRIALING
  EXPIRED
  SUSPENDED
  CANCELLED
}

enum EstimateStatus {
  PENDING
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum HandoverType {
  CUSTOMER_TO_BUSINESS
  STAFF_TO_STAFF
  BUSINESS_TO_VENDOR
  VENDOR_TO_BUSINESS
  BUSINESS_TO_CUSTOMER
}

enum CustodyHolderType {
  RECEPTION
  TECHNICIAN
  VENDOR
  CUSTOMER
  STORAGE
}

enum RepairTicketHandoverType {
  RECEPTION_TO_TECHNICIAN
  TECHNICIAN_TO_RECEPTION
  TECHNICIAN_TO_VENDOR
  VENDOR_TO_RECEPTION
  RECEPTION_TO_CUSTOMER
  INTERNAL_TRANSFER
  STORAGE_TRANSFER
}

enum InventoryMovementType {
  STOCK_IN
  STOCK_OUT
  CONSUMED
  ADJUSTMENT
  RETURNED
  TRANSFERRED
}

enum VendorRepairJobStatus {
  CREATED
  DISPATCHED
  IN_PROGRESS
  WAITING_VENDOR_QUOTE
  COMPLETED
  RETURNED
  CANCELLED
}

enum VendorRepairCostStatus {
  NOT_ESTIMATED
  ESTIMATED
  APPROVED
  INVOICED
  PAID
  CANCELLED
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

model Business {
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  slug        String         @unique
  type        BusinessType   @default(REPAIR_SHOP)
  status      BusinessStatus @default(ACTIVE)
  description String?
  logo        String?
  banner      String?
  email       String?
  phone       String?
  website     String?
  country     String?
  state       String?
  city        String?
  address     String?
  gstNumber   String?        @map("gst_number")
  metadata    Json?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  deletedAt   DateTime?      @map("deleted_at")

  customers          Customer[]
  staff              StaffMember[]
  branches           Branch[]
  subscription       Subscription?
  vendors            Vendor[]
  tickets            RepairTicket[]
  inventoryItems     InventoryItem[]
  inventoryMovements InventoryStockMovement[]
  invoices           RepairInvoice[]
  ledgerEntries      CustomerFinancialLedger[]
  financialAuditLogs RepairFinancialAuditLog[]
  ticketHandovers    RepairTicketHandover[]
  vendorRepairJobs   VendorRepairJob[]
  vendorRepairLogs   VendorRepairStatusLog[]
  vendorCostLogs     VendorRepairCostLog[]

  @@index([deletedAt])
  @@index([status])
  @@map("businesses")
}

model Branch {
  id           String       @id @default(uuid()) @db.Uuid
  businessId   String       @map("business_id") @db.Uuid
  name         String
  code         String
  phone        String?
  email        String?
  address      String?
  isMainBranch Boolean      @default(false) @map("is_main_branch")
  status       BranchStatus @default(ACTIVE)
  metadata     Json?
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  deletedAt    DateTime?    @map("deleted_at")

  business           Business                 @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customers          Customer[]
  staff              StaffMember[]
  tickets            RepairTicket[]
  estimates          RepairEstimate[]
  assignments        RepairAssignment[]
  assignmentHistory  RepairTicketAssignment[]
  technicianLogs     RepairTechnicianActivityLog[]
  inventoryItems     InventoryItem[]
  inventoryMovements InventoryStockMovement[]
  partsUsages        RepairPartsUsage[]
  invoices           RepairInvoice[]
  payments           RepairPayment[]
  ledgerEntries      CustomerFinancialLedger[]
  financialAuditLogs RepairFinancialAuditLog[]
  ticketHandovers    RepairTicketHandover[]
  vendorRepairJobs   VendorRepairJob[]
  vendorRepairLogs   VendorRepairStatusLog[]
  vendorCostLogs     VendorRepairCostLog[]

  @@unique([businessId, code])
  @@index([businessId, status])
  @@index([businessId, isMainBranch])
  @@map("branches")
}

model Subscription {
  id         String             @id @default(uuid()) @db.Uuid
  businessId String             @unique @map("business_id") @db.Uuid
  plan       SubscriptionPlan   @default(STARTER)
  status     SubscriptionStatus @default(PENDING)
  startsAt   DateTime           @default(now()) @map("starts_at")
  expiresAt  DateTime?          @map("expires_at")
  metadata   Json?
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([plan])
  @@map("subscriptions")
}

model Customer {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  branchId   String    @map("branch_id") @db.Uuid
  fullName   String    @map("full_name")
  email      String?
  phone      String
  address    String?
  metadata   Json?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  business      Business                  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch        Branch                    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  tickets       RepairTicket[]
  invoices      RepairInvoice[]
  ledgerEntries CustomerFinancialLedger[]

  @@unique([businessId, branchId, phone])
  @@index([businessId, branchId, deletedAt])
  @@index([businessId, fullName])
  @@map("customers")
}

model StaffMember {
  id                    String    @id @default(uuid()) @db.Uuid
  businessId            String    @map("business_id") @db.Uuid
  branchId              String?   @map("branch_id") @db.Uuid
  fullName              String    @map("full_name")
  email                 String
  phone                 String?
  passwordHash          String    @map("password_hash")
  refreshTokenHash      String?   @map("refresh_token_hash")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  passwordResetTokenHash      String?   @map("password_reset_token_hash")
  passwordResetExpiresAt      DateTime? @map("password_reset_expires_at")
  role                  StaffRole @default(TECHNICIAN)
  isActive              Boolean   @default(true) @map("is_active")
  metadata              Json?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  business                      Business                      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch                        Branch?                       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  assignedTickets               RepairAssignment[]            @relation("AssignedTechnician")
  assignedByRecords             RepairAssignment[]            @relation("AssignedByStaff")
  assignmentHistoryAsTechnician RepairTicketAssignment[]      @relation("AssignmentHistoryAssignedTechnician")
  assignmentHistoryAsPrevious   RepairTicketAssignment[]      @relation("AssignmentHistoryPreviousTechnician")
  assignmentHistoryAsActor      RepairTicketAssignment[]      @relation("AssignmentHistoryActor")
  technicianActivityLogs        RepairTechnicianActivityLog[] @relation("TechnicianActivityStaff")
  technicianActivityActors      RepairTechnicianActivityLog[] @relation("TechnicianActivityActor")
  statusLogs                    RepairStatusLog[]             @relation("RepairStatusActor")
  diagnoses                     RepairDiagnosis[]             @relation("DiagnosisTechnician")
  estimatesCreated              RepairEstimate[]              @relation("EstimateCreatedBy")
  estimatesApproved             RepairEstimate[]              @relation("EstimateApprovedBy")
  estimatesRejected             RepairEstimate[]              @relation("EstimateRejectedBy")
  estimateAuditLogs             RepairEstimateAuditLog[]      @relation("EstimateAuditActor")
  partsUsage                    RepairPartsUsage[]            @relation("PartsUsageTechnician")
  inventoryMovements            InventoryStockMovement[]      @relation("InventoryMovementActor")
  technicianInventoryMovements  InventoryStockMovement[]      @relation("InventoryMovementTechnician")
  paymentsCollected             RepairPayment[]               @relation("PaymentCollectedBy")
  invoicesIssued                RepairInvoice[]               @relation("InvoiceIssuedBy")
  ledgerEntriesCreated          CustomerFinancialLedger[]     @relation("LedgerEntryActor")
  financialAuditLogs            RepairFinancialAuditLog[]     @relation("FinancialAuditActor")
  custodyHandoversActed         RepairTicketHandover[]        @relation("CustodyHandoverActor")
  vendorRepairJobsCreated       VendorRepairJob[]             @relation("VendorRepairJobCreatedBy")
  vendorRepairStatusLogs        VendorRepairStatusLog[]       @relation("VendorRepairStatusActor")
  vendorRepairCostLogs          VendorRepairCostLog[]         @relation("VendorRepairCostActor")
  mediaUploaded                 RepairMedia[]                 @relation("MediaUploadedBy")
  notes                         RepairNote[]                  @relation("NoteCreatedBy")
  handoversGiven                RepairHandoverLog[]           @relation("HandoverFromStaff")
  handoversReceived             RepairHandoverLog[]           @relation("HandoverToStaff")

  @@unique([businessId, email])
  @@index([businessId, branchId])
  @@index([businessId, role, isActive])
  @@index([businessId, deletedAt])
  @@map("staff_members")
}

model Vendor {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  name       String
  email      String?
  phone      String?
  address    String?
  isActive   Boolean   @default(true) @map("is_active")
  metadata   Json?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  business        Business               @relation(fields: [businessId], references: [id], onDelete: Restrict)
  tickets         RepairTicket[]
  handovers       RepairHandoverLog[]
  ticketHandovers RepairTicketHandover[]
  inventoryItems  InventoryItem[]
  repairJobs      VendorRepairJob[]

  @@unique([businessId, name])
  @@index([businessId, isActive])
  @@index([businessId, deletedAt])
  @@map("vendors")
}

model RepairTicket {
  id                String            @id @default(uuid()) @db.Uuid
  businessId        String            @map("business_id") @db.Uuid
  branchId          String            @map("branch_id") @db.Uuid
  customerId        String            @map("customer_id") @db.Uuid
  vendorId          String?           @map("vendor_id") @db.Uuid
  ticketNumber      String            @map("ticket_number")
  title             String
  description       String?
  status            TicketStatus      @default(RECEIVED)
  priority          Priority          @default(NORMAL)
  paymentStatus     PaymentStatus     @default(PENDING) @map("payment_status")
  currentHolderType CustodyHolderType @default(RECEPTION) @map("current_holder_type")
  currentHolderId   String?           @map("current_holder_id") @db.Uuid
  currentLocation   String?           @map("current_location")
  lastHandoverAt    DateTime?         @map("last_handover_at")
  receivedAt        DateTime          @default(now()) @map("received_at")
  dueAt             DateTime?         @map("due_at")
  closedAt          DateTime?         @map("closed_at")
  laborCost         Decimal           @default(0) @map("labor_cost") @db.Decimal(12, 2)
  partsCost         Decimal           @default(0) @map("parts_cost") @db.Decimal(12, 2)
  vendorCost        Decimal           @default(0) @map("vendor_cost") @db.Decimal(12, 2)
  totalRepairCost   Decimal           @default(0) @map("total_repair_cost") @db.Decimal(12, 2)
  finalInvoiceAmount Decimal          @default(0) @map("final_invoice_amount") @db.Decimal(12, 2)
  profitEstimate    Decimal           @default(0) @map("profit_estimate") @db.Decimal(12, 2)
  diagnosis         String?
  repairNotes       String?           @map("repair_notes")
  workPerformed     String?           @map("work_performed")
  estimatedCompletionTime DateTime?   @map("estimated_completion_time")
  repairRemarks     String?           @map("repair_remarks")
  internalNotes     String?           @map("internal_notes")
  metadata          Json?
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  deletedAt         DateTime?         @map("deleted_at")

  business             Business                      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch               Branch                        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer             Customer                      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vendor               Vendor?                       @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  items                RepairTicketItem[]
  issues               RepairTicketIssue[]
  diagnoses            RepairDiagnosis[]
  statusLogs           RepairStatusLog[]
  assignments          RepairAssignment[]
  assignmentHistory    RepairTicketAssignment[]
  technicianActivities RepairTechnicianActivityLog[]
  estimates            RepairEstimate[]
  invoices             RepairInvoice[]
  partsUsage           RepairPartsUsage[]
  inventoryMovements   InventoryStockMovement[]
  payments             RepairPayment[]
  media                RepairMedia[]
  notes                RepairNote[]
  handovers            RepairHandoverLog[]
  custodyHandovers     RepairTicketHandover[]
  vendorRepairJobs     VendorRepairJob[]

  @@unique([businessId, ticketNumber])
  @@index([businessId, branchId, status])
  @@index([businessId, status, priority])
  @@index([businessId, customerId])
  @@index([businessId, vendorId])
  @@index([businessId, currentHolderType])
  @@index([businessId, deletedAt])
  @@map("repair_tickets")
}

model RepairDiagnosis {
  id                       String   @id @default(uuid()) @db.Uuid
  businessId               String   @map("business_id") @db.Uuid
  repairTicketId           String   @map("repair_ticket_id") @db.Uuid
  diagnosedByStaffId       String?  @map("diagnosed_by_staff_id") @db.Uuid
  diagnosis                String
  estimatedRepairNotes     String?  @map("estimated_repair_notes")
  estimatedTurnaroundHours Int?     @map("estimated_turnaround_hours")
  internalNotes            String?  @map("internal_notes")
  metadata                 Json?
  diagnosedAt              DateTime @default(now()) @map("diagnosed_at")
  createdAt                DateTime @default(now()) @map("created_at")

  ticket      RepairTicket @relation(fields: [repairTicketId], references: [id], onDelete: Cascade)
  diagnosedBy StaffMember? @relation("DiagnosisTechnician", fields: [diagnosedByStaffId], references: [id], onDelete: SetNull)

  @@index([businessId, repairTicketId, diagnosedAt])
  @@index([businessId, diagnosedByStaffId])
  @@map("repair_diagnoses")
}

model RepairTicketItem {
  id             String    @id @default(uuid()) @db.Uuid
  businessId     String    @map("business_id") @db.Uuid
  repairTicketId String    @map("repair_ticket_id") @db.Uuid
  itemType       String    @map("item_type")
  brand          String?
  model          String?
  serialNumber   String?   @map("serial_number")
  imei           String?
  condition      String?
  accessories    Json?
  lockPin        String?   @map("lock_pin")
  metadata       Json?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  ticket RepairTicket @relation(fields: [repairTicketId], references: [id], onDelete: Cascade)

  @@index([businessId, repairTicketId])
  @@index([businessId, serialNumber])
  @@index([businessId, imei])
  @@index([businessId, deletedAt])
  @@map("repair_ticket_items")
}

model RepairTicketIssue {
  id             String    @id @default(uuid()) @db.Uuid
  businessId     String    @map("business_id") @db.Uuid
  repairTicketId String    @map("repair_ticket_id") @db.Uuid
  title          String
  description    String?
  isConfirmed    Boolean   @default(false) @map("is_confirmed")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  ticket RepairTicket @relation(fields: [repairTicketId], references: [id], onDelete: Cascade)

  @@index([businessId, repairTicketId])
  @@index([businessId, deletedAt])
  @@map("repair_ticket_issues")
}

model RepairStatusLog {
  id             String        @id @default(uuid()) @db.Uuid
  businessId     String        @map("business_id") @db.Uuid
  repairTicketId String        @map("repair_ticket_id") @db.Uuid
  actorStaffId   String?       @map("actor_staff_id") @db.Uuid
  fromStatus     TicketStatus? @map("from_status")
  toStatus       TicketStatus  @map("to_status")
  reason         String?
  metadata       Json?
  createdAt      DateTime      @default(now()) @map("created_at")

  ticket RepairTicket @relation(fields: [repairTicketId], references: [id], onDelete: Cascade)
  actor  StaffMember? @relation("RepairStatusActor", fields: [actorStaffId], references: [id], onDelete: SetNull)

  @@index([businessId, repairTicketId, createdAt])
  @@index([businessId, toStatus])
  @@map("repair_status_logs")
}

model RepairAssignment {
  id                String           @id @default(uuid()) @db.Uuid
  businessId        String           @map("business_id") @db.Uuid
  branchId          String           @map("branch_id") @db.Uuid
  repairTicketId    String           @map("repair_ticket_id") @db.Uuid
  assignedToStaffId String           @map("assigned_to_staff_id") @db.Uuid
  assignedByStaffId String?          @map("assigned_by_staff_id") @db.Uuid
  status            AssignmentStatus @default(ASSIGNED)
  assignedAt        DateTime         @default(now()) @map("assigned_at")
  completedAt       DateTime?        @map("completed_at")
  notes             String?
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  deletedAt         DateTime?        @map("deleted_at")

  ticket     RepairTicket @relation(fields: [repairTicketId], references: [id], onDelete: Cascade)
  branch     Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  assignedTo StaffMember  @relation("AssignedTechnician", fields: [assignedToStaffId], references: [id], onDelete: Restrict)
  assignedBy StaffMember? @relation("AssignedByStaff", fields: [assignedByStaffId], references: [id], onDelete: SetNull)

  @@index([businessId, repairTicketId])
  @@index([businessId, branchId, assignedToStaffId])
  @@index([businessId, assignedToStaffId, status])
  @@index([businessId, deletedAt])
  @@map("repair_assignments")
}

model RepairTicketAssignment {
  id                        String              @id @default(uuid()) @db.Uuid
  businessId                String              @map("business_id") @db.Uuid
  branchId                  String              @map("branch_id") @db.Uuid
  repairTicketId            String              @map("repair_ticket_id") @db.Uuid
  assignedToStaffId         String              @map("assigned_to_staff_id") @db.Uuid
  previousAssignedToStaffId String?             @map("previous_assigned_to_staff_id") @db.Uuid
  assignedByStaffId         String?             @map("assigned_by_staff_id") @db.Uuid
  type                      AssignmentEventType
  reason                    String?
  notes                     String?
  metadata                  Json?
  assignedAt                DateTime            @default(now()) @map("assigned_at")
  unassignedAt              DateTime?           @map("unassigned_at")
  createdAt                 DateTime            @default(now()) @map("created_at")

  ticket             RepairTicket @relation(fields: [repairTicketId], references: [id], onDelete: Cascade)
  branch             Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  assignedTo         StaffMember  @relation("AssignmentHistoryAssignedTechnician", fields: [assignedToStaffId], references: [id], onDelete: Restrict)
  previousAssignedTo StaffMember? @relation("AssignmentHistoryPreviousTechnician", fields: [previousAssignedToStaffId], references: [id], onDelete: SetNull)
  assignedBy         StaffMember? @relation("AssignmentHistoryActor", fields: [assignedByStaffId], references: [id], onDelete: SetNull)

  @@index([businessId, repairTicketId, assignedAt])
  @@index([businessId, branchId, assignedAt])
  @@index([businessId, assignedToStaffId, assignedAt])
  @@index([businessId, previousAssignedToStaffId])
  @@index([businessId, type])
  @@map("repair_ticket_assignments")
}

model RepairTechnicianActivityLog {
  id             String                 @id @default(uuid()) @db.Uuid
  businessId     String                 @map("business_id") @db.Uuid
  branchId       String                 @map("branch_id") @db.Uuid
  repairTicketId String                 @map("repair_ticket_id") @db.Uuid
  technicianId   String                 @map("technician_id") @db.Uuid
  actorStaffId   String?                @map("actor_staff_id") @db.Uuid
  type           TechnicianActivityType
  notes          String?
  metadata       Json?
  createdAt      DateTime               @default(now()) @map("created_at")

  ticket     RepairTicket @relation(fields: [repairTicketId], references: [id], onDelete: Cascade)
  branch     Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  technician StaffMember  @relation("TechnicianActivityStaff", fields: [technicianId], references: [id], onDelete: Restrict)
  actor      StaffMember? @relation("TechnicianActivityActor", fields: [actorStaffId], references: [id], onDelete: SetNull)

  @@index([businessId, repairTicketId, createdAt])
  @@index([businessId, branchId, createdAt])
  @@index([businessId, technicianId, createdAt])
  @@index([businessId, type])
  @@map("repair_technician_activity_logs")
}

model RepairEstimate {
  id             String         @id @default(uuid()) @db.Uuid
  businessId     String         @map("business_id") @db.Uuid
  branchId       String         @map("branch_id") @db.Uuid
  repairTicketId String         @map("repair_ticket_id") @db.Uuid
  createdById    String?        @map("created_by_id") @db.Uuid
  approvedById   String?        @map("approved_by_id") @db.Uuid
  rejectedById   String?        @map("rejected_by_id") @db.Uuid
  estimateNumber String         @map("estimate_number")
  status         EstimateStatus @default(PENDING)
  subtotalAmount Decimal        @default(0) @map("subtotal_amount") @db.Decimal(12, 2)
  laborAmount    Decimal        @default(0) @map("labor_amount") @db.Decimal(12, 2)
  partsAmount    Decimal        @default(0) @map("parts_amount") @db.Decimal(12, 2)
  discountAmount Decimal        @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount      Decimal        @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount    Decimal        @default(0) @map("total_amount") @db.Decimal(12, 2)
