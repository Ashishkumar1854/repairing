  vendorRepairJobId     String                  @map("vendor_repair_job_id") @db.Uuid
  actorStaffId          String?                 @map("actor_staff_id") @db.Uuid
  previousEstimatedCost Decimal?                @map("previous_estimated_cost") @db.Decimal(12, 2)
  estimatedCost         Decimal?                @map("estimated_cost") @db.Decimal(12, 2)
  previousApprovedCost  Decimal?                @map("previous_approved_cost") @db.Decimal(12, 2)
  approvedCost          Decimal?                @map("approved_cost") @db.Decimal(12, 2)
  previousFinalCost     Decimal?                @map("previous_final_cost") @db.Decimal(12, 2)
  finalCost             Decimal?                @map("final_cost") @db.Decimal(12, 2)
  previousCostStatus    VendorRepairCostStatus? @map("previous_cost_status")
  nextCostStatus        VendorRepairCostStatus  @map("next_cost_status")
  notes                 String?
  metadata              Json?
  createdAt             DateTime                @default(now()) @map("created_at")

  business Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch   Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  job      VendorRepairJob @relation(fields: [vendorRepairJobId], references: [id], onDelete: Cascade)
  actor    StaffMember?    @relation("VendorRepairCostActor", fields: [actorStaffId], references: [id], onDelete: SetNull)

  @@index([businessId, vendorRepairJobId, createdAt])
  @@index([businessId, branchId, createdAt])
  @@index([businessId, nextCostStatus])
  @@index([businessId, actorStaffId])
  @@map("vendor_repair_cost_logs")
}

model RepairHandoverLog {
  id             String       @id @default(uuid()) @db.Uuid
  businessId     String       @map("business_id") @db.Uuid
  repairTicketId String       @map("repair_ticket_id") @db.Uuid
  vendorId       String?      @map("vendor_id") @db.Uuid
  fromStaffId    String?      @map("from_staff_id") @db.Uuid
  toStaffId      String?      @map("to_staff_id") @db.Uuid
  type           HandoverType
  notes          String?
  condition      String?
  accessories    Json?
  handedOverAt   DateTime     @default(now()) @map("handed_over_at")
  metadata       Json?
  createdAt      DateTime     @default(now()) @map("created_at")

  ticket    RepairTicket @relation(fields: [repairTicketId], references: [id], onDelete: Cascade)
  vendor    Vendor?      @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  fromStaff StaffMember? @relation("HandoverFromStaff", fields: [fromStaffId], references: [id], onDelete: SetNull)
  toStaff   StaffMember? @relation("HandoverToStaff", fields: [toStaffId], references: [id], onDelete: SetNull)

  @@index([businessId, repairTicketId, handedOverAt])
  @@index([businessId, vendorId])
  @@map("repair_handover_logs")
}

model ContactRequest {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  phone     String
  shopName  String   @map("shop_name")
  message   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("contact_requests")
}
