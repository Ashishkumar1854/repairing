NODE_ENV=development
SERVICE_NAME=backend-repair
LOG_LEVEL=debug
PORT=8000

DATABASE_URL="postgresql://repair_user:repair_password@localhost:5432/repair_db"
SHADOW_DATABASE_URL="postgresql://repair_user:repair_password@localhost:5432/repair_shadow"

POSTGRES_DB=repair_db
POSTGRES_USER=repair_user
POSTGRES_PASSWORD=repair_password
POSTGRES_PORT=5432

REDIS_URL="redis://localhost:6379"
REDIS_PORT=6379
REDIS_CONNECT_MAX_RETRIES=10
NOTIFICATION_WORKER_CONCURRENCY=5

JWT_SECRET="replace-with-a-long-random-secret"
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=5

SUPER_ADMIN_EMAILS="super_admin1@repair-erp.local,super_admin2@repair-erp.local"
SUPER_ADMIN_PASSWORD="ChangeMe@12345"

OWNER_EMAIL="owner@demo-repair.local"
OWNER_PASSWORD="ChangeMe@12345"

# Optional demo branch/admin seed. In production, Owner creates Admin from Staff Management.
SEED_ADMIN_EMAIL="admin@demo-repair.local"
SEED_ADMIN_PASSWORD="ChangeMe@12345"

# WhatsApp number used for owner subscription payment requests.
PAY_WHATSAPP="919999999999"
