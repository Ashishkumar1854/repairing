{
  "name": "backend-repair",
  "version": "1.0.0",
  "description": "Production-grade Repair ERP Backend",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "dev:local": "PORT=8001 nodemon src/server.js",
    "start": "node src/server.js",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api",
    "test": "jest --runInBand",
    "test:integration": "jest --runInBand tests/integration",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:reset": "prisma migrate reset",
    "db:push": "prisma db push",
    "db:pull": "prisma db pull",
    "db:seed": "node prisma/seed.js",
    "db:validate": "prisma validate"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [
    "repair-erp",
    "repair-saas",
    "express",
    "postgresql",
    "prisma"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.76.10",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "redis": "^5.12.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.10",
    "prisma": "^6.7.0",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=20"
  }
}
